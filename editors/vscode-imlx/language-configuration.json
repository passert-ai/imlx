{
  "brackets": [["{", "}"], ["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" },
    { "open": "$", "close": "$" }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""], ["$", "$"]],
  "folding": {
    "markers": {
      "start": "^::: \\{custom-style=",
      "end": "^:::$"
    }
  }
}
